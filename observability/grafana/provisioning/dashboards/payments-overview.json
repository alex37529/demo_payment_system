{
  "title": "payments-overview",
  "uid": "payments-overview",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": { "from": "now-15m", "to": "now" },
  "tags": ["fintech", "payments"],
  "timepicker": { "refresh_intervals": ["5s", "10s", "30s", "1m", "5m"] },
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": { "uid": "prometheus" },
        "query": "label_values(http_requests_total, service)",
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "RPS — payments/sec (POST /v1/payments)",
      "description": "Throughput of the create-payment path per service. The SLO is >= 50 TPS (tz_v2 §4).",
      "datasource": { "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 8 }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service) (rate(http_requests_total{service=~\"$service\",handler=\"/v1/payments\",method=\"POST\"}[1m]))",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Latency p50 / p95 / p99 (ms)",
      "description": "Percentiles from the high-resolution histogram (many buckets). SLO: p99 < 300 ms.",
      "datasource": { "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 0 }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(http_request_duration_highr_seconds_bucket[5m]))) * 1000",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_highr_seconds_bucket[5m]))) * 1000",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_highr_seconds_bucket[5m]))) * 1000",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Fraud circuit breaker",
      "description": "1 = OPEN (the orchestrator stopped calling the fraud API and the fallback/DLQ path took over), 0 = closed. The phase-7 exit check fires a failure injection and expects this to flip to 1.",
      "datasource": { "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "CLOSED", "color": "green", "index": 0 },
                "1": { "text": "OPEN", "color": "red", "index": 1 }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(pybreaker_open{owner=\"orchestrator\",protected=\"fraud\"})",
          "legendFormat": "fraud CB"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "DLQ messages (cumulative per topic)",
      "description": "Messages routed to a dead-letter topic. A rising line means payments are being lost to the DLQ instead of flowing through.",
      "datasource": { "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 18, "x": 6, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10 }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (topic) (dlq_messages_total)",
          "legendFormat": "{{topic}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Kafka consumer lag (messages)",
      "description": "End offset minus committed position per consumer group. Sustained lag means a consumer cannot keep up with the producer.",
      "datasource": { "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 13 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10 }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "kafka_consumer_lag",
          "legendFormat": "{{consumer}} / {{topic}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "SSE connections",
      "description": "Browsers currently attached to the notification SSE stream (/v1/stream).",
      "datasource": { "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 13 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "blue", "value": null }]
          },
          "color": { "mode": "fixed", "fixedColor": "blue" }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(sse_active_connections)",
          "legendFormat": "subscribers"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Payments processed / failed",
      "description": "Counter of completed payments (orchestrator + ledger) and failures bucketed by reason (watchdog_stalled / fraud_decline / insufficient_funds / cb_open) and by the saga step that failed. NOTE: a failing command produces NO event, so a saga that dies at 'reserve' shows up here only when the watchdog compensates it — see doc/done/07_observability_tests.md §6.",
      "datasource": { "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 13 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10 }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service) (payments_processed_total)",
          "legendFormat": "processed {{service}}"
        },
        {
          "refId": "B",
          "expr": "sum by (reason, step) (payments_failed_total)",
          "legendFormat": "failed {{reason}}{{if step}} ({{step}}){{end}}"
        }
      ]
    }
  ]
}
