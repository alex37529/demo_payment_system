# Local configuration for the fintech_demo stack.
# Copy to `.env` (make setup does it for you) and edit. `.env` is gitignored.

# ---------------------------------------------------------------------------
# Grafana
# ---------------------------------------------------------------------------
# The password the `admin` account is BOOTSTRAPPED with. Grafana reads
# GF_SECURITY_ADMIN_PASSWORD only when it creates its database (the first
# start, or after `make clean` wiped the volume) — afterwards the password
# lives in Grafana's own database and this variable is ignored.
#
# So: set your password HERE, and do not change it in the Grafana UI —
# a password changed in the UI is not reverted by this file, and it will
# silently disagree with it after the next `make clean`.
GRAFANA_ADMIN_PASSWORD=admin

# Open the dashboard without logging in (the stack is bound to localhost).
# The login form stays available if you prefer to sign in as admin.
# Set to false to require the login.
GRAFANA_ANONYMOUS=true
