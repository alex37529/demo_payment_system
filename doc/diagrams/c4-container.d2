kafka: Kafka (KRaft) {
  shape: queue
}
pg: PostgreSQL {
  shape: cylinder
}
redis: Redis {
  shape: cylinder
}
fraud: Fraud API {
  shape: hexagon
}
tempo: Tempo {
  shape: cylinder
}
obs: Prometheus + Grafana + Loki {
  shape: cylinder
}

customer -> frontend: uses
frontend -> gateway: /v1/* + SSE
gateway -> intake: POST /v1/payments
gateway -> profile: GET /v1/users
gateway -> notification: GET /v1/stream
gateway -> orchestrator: GET /v1/circuit-breakers
mock_acquirer -> intake: POST /v1/payments (load)
intake -> kafka: payments.commands
intake -> pg: idempotency_keys
intake -> redis: idempotency
orchestrator -> fraud: POST /fraud/check (CB)
orchestrator -> kafka: ledger.commands / payments.events / DLQ
orchestrator -> pg: sagas
ledger -> kafka: ledger.commands
ledger -> pg: accounts, applied_commands,\noutbox_events, transactions
kafka -> profile: ledger.events (CDC)
kafka -> notification: ledger.events (CDC)
fintech -> tempo: spans (OTLP)
fintech -> obs: metrics + logs
